# Cloudflare 边缘模式环境变量模板（完整步骤见 docs/deploy-cloudflare.md）。
# 复制为 /srv/mikiko-remote/relay.env 并替换全部占位值。

# HMAC 票据密钥（必填）：openssl rand -base64 32
RELAY_SECRET=REPLACE_WITH_RANDOM_SECRET

# 监听：WS 流量经 cloudflared tunnel 回源本机，无需对外暴露端口。
RELAY_HOST=127.0.0.1
RELAY_PORT=8080

# 二维码落地页基址 = Cloudflare Pages 自定义域（静态资源走 CF CDN，不占服务器带宽）。
RELAY_WEB_REMOTE_BASE=https://remote.example.com

# 对手机/桌面暴露的 WS 基址 = named tunnel 域名（CF 边缘 → cloudflared → 本机 8080）。
RELAY_PUBLIC_WS_BASE=wss://ws.example.com

# 可选：v2 P2P STUN 列表（逗号分隔）。
RELAY_STUN_URLS=stun:stun.l.google.com:19302
